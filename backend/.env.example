# ---------------------------------------------------------------------------
# ResumeMaxxer - backend environment template
#
#   cp .env.example .env      and fill in the real values.
#   .env is git-ignored; this file is committed. Never put secrets here.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO
PORT=8000

# --- NeonDB (serverless PostgreSQL) ----------------------------------------
# Copy the "Connection string" from the Neon dashboard. Use the POOLED endpoint
# (host contains "-pooler") for the deployed API; the direct endpoint is fine
# locally and is what Alembic migrations should use.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Set to true to log every SQL statement (verbose - development only).
SQL_ECHO=false

# --- CORS ------------------------------------------------------------------
# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Better Auth (authentication) ------------------------------------------
# Where the auth service (auth-server/) is reachable. MUST match
# BETTER_AUTH_URL in auth-server/.env exactly: it is both the `iss` and the
# `aud` claim on every JWT, and the backend verifies both.
#
# Deployed, both services fall back to the same Vercel-provided domain when
# this is unset, which is what makes preview deployments work without any
# configuration. Set it explicitly in production - see DEPLOYMENT.md.
#
# The backend needs no secret - it verifies tokens against the public keys at
# {BETTER_AUTH_URL}/api/auth/jwks.
BETTER_AUTH_URL=http://localhost:3000

# --- Google Gemini ---------------------------------------------------------
# From Google AI Studio -> Get API key. Used by the `google-genai` SDK.
#
# This key funds the FREE weekly allowance only (see backend/quota.py - three
# tailoring runs per student per week). Past that, a student adds their own key
# in the app and their requests run on it instead, so this key's spend is
# bounded by the number of active students rather than by how much they use it.
#
# Leaving this empty is a supported configuration: free runs then fail with a
# message telling the student to add their own key, and everything else works.
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any model your key can reach. Flash is the right default here: the tailoring
# work is extraction and rewriting, not open-ended generation.
GEMINI_MODEL=gemini-2.0-flash

# --- LaTeX PDF service -----------------------------------------------------
# The resume is real LaTeX, compiled by the container in docker-compose.yml.
# Start it with `docker compose up -d`. LATEX_API_KEY must match API_KEY there.
#
# Deployed, LATEX_API_URL is NOT set by hand: Vercel injects it from the
# service binding declared in vercel.json, pointing at the internal container.
# Setting it manually there would override the binding and send resume content
# somewhere unintended.
LATEX_API_URL=http://localhost:2020
LATEX_API_KEY=resumemaxxer-local-dev

# --- Database pool (optional) ----------------------------------------------
# Defaults adapt automatically: a normal pool on a long-lived server, a tiny
# one when VERCEL is set, because dozens of serverless instances each holding
# connections will exhaust Neon. Override only if you have measured a reason.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_RECYCLE=300

# --- GitHub import (optional) ----------------------------------------------
# Unauthenticated GitHub API calls are limited to 60 requests/hour per IP. A
# fine-grained token with public read access raises that to 5,000/hour.
GITHUB_TOKEN=
