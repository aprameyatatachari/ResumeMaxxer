# ---------------------------------------------------------------------------
# ResumeMaxxer - backend environment template
#
#   cp .env.example .env      and fill in the real values.
#   .env is git-ignored; this file is committed. Never put secrets here.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO
PORT=8000

# --- NeonDB (serverless PostgreSQL) ----------------------------------------
# Copy the "Connection string" from the Neon dashboard. Use the POOLED endpoint
# (host contains "-pooler") for the deployed API; the direct endpoint is fine
# locally and is what Alembic migrations should use.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Set to true to log every SQL statement (verbose - development only).
SQL_ECHO=false

# --- CORS ------------------------------------------------------------------
# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Better Auth (authentication) ------------------------------------------
# Where the auth service (auth-server/) is reachable. MUST match
# BETTER_AUTH_URL in auth-server/.env exactly: it is both the `iss` and the
# `aud` claim on every JWT, and the backend verifies both.
#
# The backend needs no secret - it verifies tokens against the public keys at
# {BETTER_AUTH_URL}/api/auth/jwks.
BETTER_AUTH_URL=http://localhost:3000

# --- Google Gemini ---------------------------------------------------------
# From Google AI Studio -> Get API key. Used by the `google-genai` SDK.
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any model your key can reach. Flash is the right default here: the tailoring
# work is extraction and rewriting, not open-ended generation.
GEMINI_MODEL=gemini-2.0-flash

# --- GitHub import (optional) ----------------------------------------------
# Unauthenticated GitHub API calls are limited to 60 requests/hour per IP. A
# fine-grained token with public read access raises that to 5,000/hour.
GITHUB_TOKEN=
