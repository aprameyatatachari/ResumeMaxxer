# ---------------------------------------------------------------------------
# ResumeMaxxer - auth service environment template
#
#   cp .env.example .env      and fill in the real values.
# ---------------------------------------------------------------------------

PORT=3000

# Where this service is reachable. Becomes the JWT `iss` and `aud` claims, so
# backend/.env BETTER_AUTH_URL must match it exactly.
#
# Deployed, leave this unset and both services derive the same value from
# Vercel's own variables (see resolveBaseUrl in src/auth.ts and
# _resolve_auth_url in backend/auth.py) - that is what lets preview
# deployments authenticate with no configuration. In production, set it to
# your real domain in the Vercel dashboard. See DEPLOYMENT.md.
BETTER_AUTH_URL=http://localhost:3000

# The browser app's origin. Used for CORS and as a trusted origin (CSRF).
# Deployed this is the SAME origin as BETTER_AUTH_URL - the frontend and this
# service sit behind one domain, split by path - and it defaults to that, so it
# does not need setting on Vercel either.
FRONTEND_URL=http://localhost:5173

# Signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a DIFFERENT value in production, and never commit it.
BETTER_AUTH_SECRET=

# The SAME Neon connection string the backend uses. Better Auth creates and
# owns its own tables (user, session, account, verification, jwks) alongside
# the API's tables.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
