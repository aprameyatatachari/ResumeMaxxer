# ---------------------------------------------------------------------------
# ResumeMaxxer - frontend environment template
#
#   cp .env.example .env.local      and fill in the real values.
#   .env.local is git-ignored.
#
# WARNING: everything prefixed with VITE_ is compiled into the JavaScript
# bundle and is publicly readable. Only ever put PUBLIC values here. The
# BETTER_AUTH_SECRET and the Gemini API key belong in auth-server/.env and
# backend/.env respectively, never in this file.
# ---------------------------------------------------------------------------

# Where the Better Auth service is listening. Must match BETTER_AUTH_URL in
# auth-server/.env and backend/.env - it is the JWT issuer and audience.
VITE_AUTH_URL=http://localhost:3000

# Where the FastAPI backend is listening.
VITE_API_URL=http://localhost:8000
