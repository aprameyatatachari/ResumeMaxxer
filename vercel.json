{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend/"
    },
    "auth": {
      "root": "auth-server/",
      "framework": "express"
    },
    "api": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "bindings": [
        {
          "type": "service",
          "service": "latex",
          "format": "url",
          "env": "LATEX_API_URL"
        }
      ]
    },
    "latex": {
      "root": "latex/",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    { "source": "/api/auth/(.*)", "destination": { "service": "auth" } },
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/health", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
