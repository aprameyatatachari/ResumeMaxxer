# Normalise line endings so the repo is identical on Windows and the Linux CI
# runners. Without this, files committed from Windows carry CRLF, and the
# inline `run:` shell blocks in the CI workflow fail on Ubuntu with
# "\r: command not found".
* text=auto eol=lf

# Windows-only, and cmd.exe needs CRLF.
*.bat text eol=crlf

# Binary: never touch.
*.png binary
*.jpg binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ico binary
